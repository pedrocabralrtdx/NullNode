{
  "name": "nullnode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A cyberpunk social network built around an explorable 3D city powered by Three.js, React, and WebSockets.",
  "author": "Pedro Júlio Cabral Neto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrocabralrtdx/NullNode.git"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
